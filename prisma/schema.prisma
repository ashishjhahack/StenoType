generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Test {
  id          String     @id @default(cuid())

  title       String
  category    String
  language    String
  difficulty  Difficulty
  targetWpm   Int        @default(60)
  duration    Int
  passage     String     @db.Text

  status      TestStatus @default(DRAFT)

  createdBy   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  attempts    Attempt[]
}

model Attempt {
  id          String   @id @default(cuid())

  clerkUserId String
  testId      String

  wpm         Float
  accuracy    Float
  errors      Int
  timeTaken   Int

  completedAt DateTime @default(now())

  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([clerkUserId])
  @@index([testId])
  @@index([clerkUserId, completedAt])
}